            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetId\": \"ASSET-999\",\n  \"name\": \"Database Server Secondary\",\n  \"type\": \"Server\",\n  \"ipAddress\": \"192.168.10.35\",\n  \"os\": \"Ubuntu 24.04 LTS\",\n  \"owner\": \"Database Admin\",\n  \"location\": \"DC-2\",\n  \"status\": \"active\",\n  \"criticality\": \"high\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/assets", "host": ["{{baseUrl}}"], "path": ["assets"] }
          }
        }
      ]
    },
